; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DarkestCards"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/image="uid://b3jlktytgdrf2"
config/icon="uid://b3jlktytgdrf2"

[autoload]

SessionDiagnostics="*res://scripts/autoload/SessionDiagnostics.gd"
PlaytimeManager="*res://scripts/autoload/PlaytimeManager.gd"
Localization="*res://scripts/autoload/Localization.gd"
CardDatabase="*res://scripts/autoload/CardDatabase.gd"
SaveSlots="*res://scripts/autoload/SaveManager.gd"
CollectionManager="*res://scripts/autoload/CollectionManager.gd"
GameCurrency="*res://scripts/GameCurrency.gd"
DeckManager="*res://scripts/autoload/DeckManager.gd"
RarityEffects="*res://scripts/Rarityeffects.gd"
CardUpgradeManager="*res://scripts/CardUpgradeManager.gd"
EffectDatabase="*res://scripts/autoload/EffectDatabase.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
NetworkManager="*res://scripts/autoload/NetworkManager.gd"
AchievementManager="*res://scripts/autoload/AchievementManager.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=8

[display]

window/size/mode=3

